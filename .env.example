# Copia este archivo a .env. Ese archivo no se sube.
# Twitch: https://dev.twitch.tv/console/apps — make seed, make franchise, make videos.
# RAWG es opcional y hoy no se usa. ADMIN_USER y ADMIN_PASS vacíos dejan /admin en 404.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

RAWG_API_KEY=

PORT=8080
LISTEN_HOST=127.0.0.1
SEED_PATH=seed/seed.json
API_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USD_MXN=
DEMO_TODAY=

ADMIN_USER=
ADMIN_PASS=

BTB_UID=
BTB_GID=
